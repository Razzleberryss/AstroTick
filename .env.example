# ===========================================================================
# AstroTick — Kalshi 15-minute BTC trader: environment variables
#
# Copy this file to .env and fill in your Kalshi credentials.
# NEVER commit .env to version control.
#
# Every variable config.py reads is listed here. Variables that are commented
# out are optional; the value shown is the code default from config.py, so
# leaving them commented changes nothing. Uncomment only what you want to tune.
# ===========================================================================

# — Kalshi API credentials (required) ———————————————————————————————————
# Create a key at: https://kalshi.com/profile/api-management
# The REST SDK accepts RSA and Ed25519 keys; the optional WebSocket client
# signs with RSA-PSS, so use an RSA key if you enable USE_WEBSOCKET_ORDERBOOK.
KALSHI_API_KEY_ID=your-api-key-id-here
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem

# — Environment ————————————————————————————————————————————————————————
# 'demo' = paper trading (free, no real money), 'prod' = live real-money API.
# Code default is 'prod'; 'demo' is set here deliberately as the safe start.
KALSHI_ENV=demo

# — Safety gates ———————————————————————————————————————————————————————
# DRY_RUN=true (the default) logs and simulates orders but never sends them.
DRY_RUN=true

# Live orders additionally require KALSHI_TRADING_LIVE=1. With DRY_RUN=false
# but KALSHI_TRADING_LIVE unset, every order is rejected (LIVE_TRADING_BLOCKED).
# Both gates must be opened for real trading:
#   DRY_RUN=false KALSHI_TRADING_LIVE=1 python bot.py
#KALSHI_TRADING_LIVE=1

# Halt file: if this file exists, all order placement stops immediately
# (bot and CLI alike). The decision engine also creates it on HALT_TRADING.
# Default path: ~/.openclaw/workspace/STOP_TRADING
#OPENCLAW_STOP_FILE=~/.openclaw/workspace/STOP_TRADING

# — Risk controls ——————————————————————————————————————————————————————
# Max dollars to risk on a single trade (default: 10)
#MAX_TRADE_DOLLARS=10
# Max number of open positions at any time (default: 3)
#MAX_OPEN_POSITIONS=3
# Max total dollars deployed across all open positions (default: 50)
#MAX_TOTAL_EXPOSURE=50
# Max realized loss per UTC day before blocking NEW entries, in cents (default: 1000)
#MAX_DAILY_LOSS_CENTS=1000
# Max number of NEW entries per UTC day (default: 20)
#MAX_DAILY_TRADES=20
# Allowed ENTRY price range in cents, 1-99 (defaults: 10 / 90).
# Exits are exempt and may use the full 1-99c range.
#MIN_CONTRACT_PRICE_CENTS=10
#MAX_CONTRACT_PRICE_CENTS=90

# — Exit / position management —————————————————————————————————————————
# Sell if the contract price falls this many cents below entry; 0 disables (default: 20)
#STOP_LOSS_CENTS=20
# Sell if the contract price rises this many cents above entry; 0 disables (default: 30)
#TAKE_PROFIT_CENTS=30
# Sell an open position when the signal flips against it (default: true)
#SIGNAL_REVERSAL_EXIT=true
# Minimum reversal-signal confidence required to trigger that exit (default: 0.02).
# Note: despite the name, this gates the signal-reversal EXIT, not entries —
# entry edge is controlled by MIN_EDGE_PCT below.
#MIN_EDGE_THRESHOLD=0.02
# Seconds before the market's close time to force an expiry exit (default: 120)
#EXPIRY_EXIT_SECONDS=120

# — Strategy mode ——————————————————————————————————————————————————————
# fee_aware_model  = momentum + orderbook skew with fee-aware EV filter (default)
# reddit_time_delay = late-window price-trigger strategy
#STRATEGY_MODE=fee_aware_model

# reddit_time_delay parameters (used only in that mode):
# Price (0.0-1.0, dollars) the winning side must reach to trigger an entry (default: 0.90)
#TRIGGER_POINT_PRICE=0.90
# Price (0.0-1.0) at which an open position is exited early (default: 0.40)
#EXIT_POINT_PRICE=0.40
# Only arm the strategy when this many minutes (or fewer) remain before expiry (default: 14)
#TRIGGER_MINUTE_REMAINING=14
# Max entries per 15-minute window (default: 1)
#MAX_TRADES_PER_WINDOW=1

# — Market / signal ————————————————————————————————————————————————————
# Crypto Up/Down series to trade, comma-separated. All configured series are
# traded in parallel, each with momentum from its own settlement index.
# (default: the single series from BTC_SERIES_TICKER)
#SERIES_TICKERS=KXBTC15M,KXETH15M,KXSOL15M
# Legacy single-series setting, used when SERIES_TICKERS is unset.
# KXBTC15M is the live BTC 15-minute series. (default: KXBTC15M)
#BTC_SERIES_TICKER=KXBTC15M
# yfinance symbol for the BTC spot FALLBACK feed. Momentum normally comes from
# the settlement index itself (Kalshi /live_data); yfinance is only used when
# that endpoint is unavailable, with ETH/SOL mapped automatically. (default: BTC-USD)
#BTC_TICKER=BTC-USD
# Number of 1-minute bars to look back for momentum (default: 5)
#MOMENTUM_LOOKBACK_BARS=5
# yfinance period for the fallback momentum download. Must be a valid yfinance
# period ("1d", "5d", ...); minute-style values like "60m" are rejected. (default: 1d)
#BTC_MOMENTUM_HISTORY_PERIOD=1d
# Use orderbook-derived quotes instead of /markets API fields (default: true)
#USE_ORDERBOOK_PRICES=true
# Stream the orderbook over WebSocket instead of REST polling; falls back to
# REST automatically when the stream is unavailable or stale (default: false)
#USE_WEBSOCKET_ORDERBOOK=false
# Minimum composite-signal confidence to consider a trade at all (default: 0.003)
#MIN_CONFIDENCE=0.003
# Max |model probability - market mid| before a signal is discarded as
# implausible. Must be at least MIN_EDGE_PCT + 0.05 (default: 0.20)
#MAX_PRICE_DEVIATION=0.20
# Max spread-based slippage (0.0-1.0) tolerated at entry (default: 0.20)
#MAX_SLIPPAGE=0.20

# — Liquidity filters ——————————————————————————————————————————————————
# Minimum orderbook depth (contracts) at the best bid level, per side.
# The check is side-aware: a NO entry requires NO-side depth. (defaults: 5 / 5)
#MIN_YES_DEPTH=5
#MIN_NO_DEPTH=5
# How wide (in probability, 0.0-1.0) around mid to count depth (default: 0.20)
#DEPTH_BAND=0.20

# — Fee-aware entry settings ———————————————————————————————————————————
# Kalshi taker fee rate used in the EV filter: fees are
# ceil(KALSHI_FEE_RATE * contracts * P * (1-P)) in cents. 0.07 matches the
# standard schedule and KXBTC15M's fee_type=quadratic / fee_multiplier=1.
#KALSHI_FEE_RATE=0.07
# Minimum probability mispricing (percentage points) required to trade (default: 0.10)
#MIN_EDGE_PCT=0.10
# Forbidden price band: skip entries when the YES price is in this range.
# Fees bite hardest near 0.50. (defaults: 0.35 / 0.56)
#FORBIDDEN_PRICE_LOW=0.35
#FORBIDDEN_PRICE_HIGH=0.56
# Minimum expected net value per contract after open+close fees, in dollars (default: 0.02)
#MIN_EXPECTED_NET_PER_CONTRACT=0.02
# Position-sizing bounds (in contracts) for the edge-scaled sizer (defaults: 1 / 10)
#BASE_SIZE=1
#MAX_SIZE=10
# At this mispricing level (and above) the sizer uses MAX_SIZE (default: 0.30)
#MAX_EDGE_PCT=0.30

# — Bot loop ———————————————————————————————————————————————————————————
# How often the bot runs a cycle, in seconds (default: 10)
#POLL_INTERVAL_SECONDS=10
# Skip rewriting dashboard_state.json when unchanged within this many seconds;
# 0 writes every cycle (default: 2)
#DASHBOARD_MIN_WRITE_SECONDS=2

# — API client —————————————————————————————————————————————————————————
# Per-request timeout in seconds (default: 5)
#REQUEST_TIMEOUT_SECONDS=5
# Retry attempts for transient read-only API errors; order placement is never
# auto-retried. 0 disables retries. (default: 2)
#REQUEST_MAX_RETRIES=2

# — Logging & output ———————————————————————————————————————————————————
# DEBUG | INFO | WARNING | ERROR (default: INFO)
#LOG_LEVEL=INFO
# CSV file where every entry and exit is logged (default: trades.csv)
#TRADE_LOG_FILE=trades.csv

# — Manual CLI (openclaw_kalshi.py) only ———————————————————————————————
# Default series for the CLI's status/markets/orderbook/buy/sell commands
# (the bot ignores this). Equivalent to passing --series. (default: KXBTCD)
#HOURLY_SERIES_TICKER=KXBTCD

# — Test harness only ——————————————————————————————————————————————————
# Set to 1 to stop config.py from loading this .env (used by the test suite).
#ASTROTICK_SKIP_DOTENV=0
